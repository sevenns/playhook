.DS_Store

# umu-launcher zipapp is fetched at build time (scripts/fetch-umu.mjs), never committed.
resources/umu/

# Build artifacts must never live next to their .ts sources in src/: a stale .js beside its .ts shadows
# the source for every tool that resolves extensionless imports.
src/**/*.js
src/**/*.js.map
